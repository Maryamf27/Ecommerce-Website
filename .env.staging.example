# Staging template. Use a staging-only MongoDB database and Stripe test credentials.
NODE_ENV=production
MONGODB_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
APP_ORIGIN=
APP_ALLOW_VERCEL_PREVIEW=true

# Optional tuning
DEMO_INITIAL_STOCK=12
LOW_STOCK_THRESHOLD=5
LOGIN_LOCKOUT_ESCALATION_RESET_HOURS=24
